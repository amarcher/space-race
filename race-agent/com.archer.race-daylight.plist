<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.archer.race-daylight</string>

    <!-- Stdlib-only, so the system python is enough: worklist.py imports
         poller.py (also stdlib) and shells out to `claude`. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/archer/Programs/space-race/race-agent/worklist.py</string>
        <string>--run</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/archer/Programs/space-race</string>

    <!-- Two passes inside the daylight window. RunAtLoad is false on
         purpose: installing or reloading this job must not start a build.
         launchd fires a MISSED calendar job the moment the Mac wakes, so
         worklist.py enforces the 9:00–18:00 window itself — a lid opened at
         03:00 can never start one. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>9</integer>
            <key>Minute</key><integer>40</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>14</integer>
            <key>Minute</key><integer>40</integer>
        </dict>
    </array>
    <key>RunAtLoad</key>
    <false/>

    <!-- Logs outside the repo, next to the rest of the race-agent state. -->
    <key>StandardOutPath</key>
    <string>/Users/archer/.space-race/race-agent/daylight.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/archer/.space-race/race-agent/daylight.err.log</string>
</dict>
</plist>
