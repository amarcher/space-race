<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.archer.race-agent</string>

    <!-- The pyenv python on purpose: daemon.py needs slack_sdk (Socket Mode
         WebSocket — push events, no inbound port). The sweep engine it
         drives (poller.py) stays stdlib-only and runs on any python. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/archer/.pyenv/versions/3.13.13/bin/python</string>
        <string>/Users/archer/.space-race/race-agent/checkout/race-agent/daemon.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/archer/.space-race/race-agent/checkout</string>

    <!-- A persistent Socket Mode daemon: launchd restarts it if it dies
         (network flap, Slack disconnect, bug). Every (re)start begins with
         a catch-up sweep, so restarts can't lose messages — the watermark
         in ~/.space-race/race-agent/state.json is the source of truth. -->
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <!-- Don't hot-loop if the daemon crashes at startup (bad token etc.). -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- Logs and state live OUTSIDE the repo (~/.space-race/race-agent/) so
         nothing run-generated — including agent run transcripts — can ever
         land in a commit. -->
    <key>StandardOutPath</key>
    <string>/Users/archer/.space-race/race-agent/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/archer/.space-race/race-agent/launchd.err.log</string>
</dict>
</plist>
