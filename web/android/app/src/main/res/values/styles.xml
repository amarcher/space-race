<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>

        <!-- True edge-to-edge. MainActivity calls setDecorFitsSystemWindows(false)
             so the WebView extends behind the bars, but that alone leaves the bars
             painted with their own background — an opaque black nav bar that cuts
             the starfield off. Clear both so the game really does reach the edges.
             The two *Contrast flags matter as much as the colors: on API 29+ the
             system re-adds a translucent scrim behind a transparent bar unless
             they're off, which is what put the black band under the hand. Ignored
             harmlessly on our older minSdk-24 range. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>


    <!-- Launch theme. The pre-activity OS stages carry NO art (#141): both
         windowSplashScreenAnimatedIcon (@drawable/splash_icon) and the window
         background are flat @color/spaceBg. The ace pilot used to appear in both
         — round-masked at icon scale, then stretched full-bleed — before the web
         layer showed him a third time at a third scale, which read as him zooming
         twice on the way in. Neither stage can be crop-matched to the web layer:
         the icon is circle-masked at icon size, and a window-background bitmap is
         scaled to FILL with no aspect preservation.
         He now appears exactly ONCE, at one scale, across two surfaces that agree
         by construction: the Capacitor SplashScreen plugin's ImageView
         (CENTER_CROP over @drawable/splash) and then BootSplash.tsx's still —
         same source file, same cover rule — continued by the takeover clip.
         postSplashScreenTheme hands off to the dark no-action-bar theme so
         there's no white flash before the webview paints. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/spaceBg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <!-- The window background covers the sliver BEFORE the activity exists,
             so it must stay a flat field: a bitmap here is stretched to fill with
             no aspect preservation and cannot be crop-matched to anything. The
             ace-pilot still comes from the Capacitor SplashScreen plugin's
             ImageView instead (CENTER_CROP, capacitor.config.ts) — same file,
             same crop as BootSplash.tsx's still. -->
        <item name="android:background">@color/spaceBg</item>
    </style>
</resources>